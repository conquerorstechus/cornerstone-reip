{
  "name": "RIP · High ROI digest",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "weeks", "weeksInterval": 1, "triggerAtDay": [5], "triggerAtHour": 8 }] }
      },
      "id": "rip-d-cron",
      "name": "Friday 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-560, 120]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rip-high-roi-digest",
        "options": {}
      },
      "id": "rip-d-webhook",
      "name": "Manual webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-560, -40],
      "webhookId": "rip-high-roi-digest"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.APP_BASE_URL}}/api/digest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-webhook-secret", "value": "={{$env.N8N_SHARED_SECRET}}" }
          ]
        },
        "options": {}
      },
      "id": "rip-d-get",
      "name": "GET /api/digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-280, 40]
    },
    {
      "parameters": {
        "jsCode": "const digest = $input.first().json;\nconst lines = (digest.deals || []).map((d) => `Rank #${d.rank}  ${d.address}\\nAsk ${d.ask}  Offer ${d.offer}  CF $${d.cashFlow}/mo  Rent $${d.rent}/mo\\nTax $${d.taxMonthly} · HOA $${d.hoaMonthly} · Mortgage $${d.mortgageMonthly} (50% dn)`).join('\\n\\n');\nlet runId = null;\nlet callbackUrl = null;\ntry {\n  const hook = $('Manual webhook').first().json;\n  const b = hook.body || hook;\n  runId = b.runId || null;\n  callbackUrl = b.callbackUrl || null;\n} catch (e) {}\nreturn [{ json: { runId, callbackUrl, subject: `${digest.title} — ${digest.date}`, text: lines, digest } }];"
      },
      "id": "rip-d-fmt",
      "name": "Format email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-40, 40]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "has-run",
              "leftValue": "={{$json.runId}}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "rip-d-if",
      "name": "Has runId?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [180, 40]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.callbackUrl || $env.APP_BASE_URL + '/api/webhooks/n8n'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "x-webhook-secret", "value": "={{$env.N8N_SHARED_SECRET}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({ runId: $json.runId, result: { title: $json.subject, subtitle: 'High ROI digest', investorScore: 90, recommendation: 'pursue', summary: $json.text.slice(0, 480), metrics: [{ label: 'Deals', value: String(($json.digest.deals || []).length) }], sections: [{ heading: 'Digest body', body: $json.text }] } })}}",
        "options": {}
      },
      "id": "rip-d-cb",
      "name": "POST RIP callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, -40]
    }
  ],
  "connections": {
    "Friday 8am": { "main": [[{ "node": "GET /api/digest", "type": "main", "index": 0 }]] },
    "Manual webhook": { "main": [[{ "node": "GET /api/digest", "type": "main", "index": 0 }]] },
    "GET /api/digest": { "main": [[{ "node": "Format email", "type": "main", "index": 0 }]] },
    "Format email": { "main": [[{ "node": "Has runId?", "type": "main", "index": 0 }]] },
    "Has runId?": { "main": [[{ "node": "POST RIP callback", "type": "main", "index": 0 }], []] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "rip-digest-v1"
}
